rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Dynamic banner slides
    match /bannerSlides/{slideId} {
      allow read: if true;
      allow write: if isValidId(slideId);
    }

    // Portfolio & real production photos
    match /galleryItems/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    // Orders and Proformas
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId);
      allow update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }
  }
}
